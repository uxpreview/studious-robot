{#
/**
 * @file
 * Calder page layout.
 *
 * Content types designed by this theme (people, conditions, trials and so on)
 * print their own page headers, so the generic title and breadcrumb only show
 * on other pages: listings, search, forms, account pages.
 *
 * @see \Drupal\calder\Hook\CalderHooks::preprocessPage()
 */
#}
<div class="layout-container flex min-h-screen flex-col">
  {{ include('calder:site-header', {
    main: calder_menus.main,
    utility: calder_menus.utility,
    front_url: front_page,
  }, with_context = false) }}

  {{ page.header }}
  {{ page.highlighted }}
  {{ page.help }}

  <main role="main" class="flex-1">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    {% if not rendered_by_canvas and not calder_designed_page and not is_front %}
      <div class="border-b border-line">
        <div class="container mx-auto px-4 pt-8 pb-10 md:pt-12 md:pb-14">
          <div class="mb-6 text-sm">{{ breadcrumb }}</div>
          {% if calder_intro %}
            <div class="mb-5">{{ include('calder:mission-marker', { mission: calder_intro[0], label: calder_intro[1] }, with_context = false) }}</div>
          {% endif %}
          {{ title }}
          {% if calder_intro %}
            <p class="mt-5 mb-0 max-w-3xl text-[1.3125rem] leading-relaxed text-ink-soft">{{ calder_intro[2] }}</p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="layout-content {{ calder_intro ? 'container mx-auto px-4 py-12 md:py-16' }}">
      {{ page.content }}
    </div>
  </main>

  {{ include('calder:site-footer', { columns: calder_menus.footer }, with_context = false) }}
</div>
