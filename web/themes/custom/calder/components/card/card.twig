{#
/**
 * @file
 * Content card. Variants:
 * - grid: stacked, optional image on top. Used in grids and connections.
 * - row: horizontal, with a calendar block for events. Used in listings.
 */
#}
{% set h = 'h' ~ (heading_level|default(3)) %}
{% set variant = variant|default('grid') %}
{% set rule = { care: 'before:bg-care', learn: 'before:bg-learn', discover: 'before:bg-discover', neutral: 'before:bg-ink' } %}

{% set date_block %}
  {% if date %}
    <div class="flex w-[4.5rem] shrink-0 flex-col items-center justify-center rounded-xl border border-line bg-paper py-2.5 text-center leading-none {{ date.is_past ? 'opacity-70' }}">
      <span class="text-[0.75rem] font-bold tracking-[0.12em] uppercase text-care-deep">{{ date.month }}</span>
      <span class="mt-1 font-serif text-[2rem] font-medium">{{ date.day }}</span>
      <span class="mt-1 text-[0.6875rem] text-ink-soft">{{ date.weekday|slice(0, 3) }}</span>
    </div>
  {% endif %}
{% endset %}

{% set body %}
  <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    {% if eyebrow %}{{ include('calder:mission-marker', { mission: mission, label: eyebrow }, with_context = false) }}{% endif %}
    {% if status %}{{ include('calder:pill', status, with_context = false) }}{% endif %}
  </div>
  <{{ h }} class="mt-3 font-serif text-[1.375rem] leading-[1.2] font-medium text-pretty">
    <a href="{{ url }}" class="no-underline after:absolute after:inset-0 after:rounded-2xl group-hover:underline">{{ title }}</a>
  </{{ h }}>
  {% if text %}<p class="mt-2.5 mb-0 line-clamp-3 text-base text-ink-soft">{{ text }}</p>{% endif %}
  {% if meta %}
    <ul class="mt-auto flex list-none flex-col gap-1.5 p-0 pt-5 text-sm text-ink-soft">
      {% for m in meta %}
        <li class="m-0 flex gap-2"><span class="shrink-0 text-ink-muted">{{ icon('phosphor', m.icon, { size: 16 }) }}</span><span>{{ m.text }}</span></li>
      {% endfor %}
    </ul>
  {% endif %}
{% endset %}

{% if variant == 'row' %}
  <article class="group relative flex gap-5 rounded-2xl border border-line bg-white p-5 transition-shadow before:absolute before:top-6 before:bottom-6 before:left-0 before:w-[3px] before:rounded-r hover:shadow-md md:gap-7 md:p-7 {{ rule[mission] ?? rule.neutral }}">
    {{ date_block }}
    <div class="flex min-w-0 flex-1 flex-col">{{ body }}</div>
  </article>
{% else %}
  <article class="group relative flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white transition-shadow hover:shadow-md">
    {% if image.src %}
      <img src="{{ image.src }}" alt="" class="aspect-[3/2] w-full object-cover" loading="lazy" width="{{ image.width }}" height="{{ image.height }}">
    {% endif %}
    <div class="flex flex-1 flex-col p-6">
      {% if date %}<div class="mb-4">{{ date_block }}</div>{% endif %}
      {{ body }}
    </div>
  </article>
{% endif %}
