{% set bgs = { paper: 'bg-paper', white: 'bg-white', sand: 'bg-sand', night: 'dark bg-night text-paper' } %}
{% set cols = { '1': 'grid-cols-1', '2': 'md:grid-cols-2', '3': 'md:grid-cols-2 lg:grid-cols-3', '4': 'sm:grid-cols-2 lg:grid-cols-4' } %}
{% set background = background|default('paper') %}
<section class="{{ bgs[background] }} {{ background != 'paper' ? '' : 'border-b border-line' }}">
  <div class="container mx-auto px-4 py-16 md:py-24">
    {% if eyebrow or heading or intro or (link_label and link_url) %}
      <div class="mb-10 flex flex-wrap items-end justify-between gap-6 md:mb-14">
        <div class="max-w-3xl">
          {% if eyebrow %}<div class="mb-4">{{ include('calder:mission-marker', { mission: mission|default('neutral'), label: eyebrow }, with_context = false) }}</div>{% endif %}
          {% if heading %}<h2 class="text-headline">{{ heading }}</h2>{% endif %}
          {% if intro %}<p class="mt-4 mb-0 text-xl {{ background == 'night' ? 'text-muted-foreground' : 'text-ink-soft' }}">{{ intro }}</p>{% endif %}
        </div>
        {% if link_label and link_url %}<a href="{{ link_url }}" class="inline-flex items-center gap-2 font-bold {{ background == 'night' ? 'text-paper' : 'text-ink' }}">{{ link_label }}{{ icon('phosphor', 'arrow-right', { size: 18 }) }}</a>{% endif %}
      </div>
    {% endif %}
    <div class="grid gap-6 {{ cols[columns|default('3')] }} [&_.calder-view]:col-span-full">
      {{ content }}
    </div>
  </div>
</section>
