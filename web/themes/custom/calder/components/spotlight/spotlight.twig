{#
/**
 * @file
 * Person spotlight. The person hangs from the top like the pivot of a mobile;
 * each role hangs below on its own wire, in its mission color.
 */
#}
{% set shapes = {
  care: 'bg-care rounded-[55%_45%_50%_50%/60%_55%_45%_40%]',
  learn: 'bg-learn rounded-full',
  discover: 'bg-discover rounded-[40%_60%_55%_45%/50%_45%_55%_50%]',
} %}
<section class="border-b border-line bg-white">
  <div class="container mx-auto grid gap-14 px-4 py-16 md:py-24 lg:grid-cols-12">
    <div class="lg:col-span-4">
      {% if eyebrow %}{{ include('calder:mission-marker', { mission: 'neutral', label: eyebrow }, with_context = false) }}{% endif %}
      <h2 class="mt-5 text-headline">{{ heading }}</h2>
      {% if text %}<p class="mt-5 mb-0 text-xl text-ink-soft">{{ text }}</p>{% endif %}
      <a href="{{ person.url }}" class="button mt-8">See {{ person.formal_name }}’s profile{{ icon('phosphor', 'arrow-right', { size: 20 }) }}</a>
    </div>

    <div class="lg:col-span-8">
      <div class="flex flex-col items-center text-center">
        <span class="block h-8 w-[1.5px] bg-ink" aria-hidden="true"></span>
        {{ include('calder:avatar', { initials: person.initials, roles: roles|map(r => r.mission), photo: person.photo, size: 'lg' }, with_context = false) }}
        <p class="mt-5 mb-0 font-serif text-[1.75rem] leading-tight">{{ person.display_name }}</p>
        <p class="mt-1 mb-0 max-w-md text-base text-ink-soft">{{ person.job_title }}</p>
      </div>

      {# The arm: one wire across, with a drop for each role. Class names are
         spelled out in full so Tailwind can find them. #}
      {% set layouts = {
        1: 'md:grid-cols-1 before:hidden',
        2: 'md:grid-cols-2 before:left-1/4 before:right-1/4',
        3: 'md:grid-cols-3 before:left-[16.66%] before:right-[16.66%]',
      } %}
      <ol class="relative m-0 mt-8 grid list-none gap-6 p-0 pt-10 {{ layouts[roles|length] ?? layouts[3] }} before:absolute before:top-0 before:h-[1.5px] before:bg-ink max-md:before:hidden" aria-label="{{ person.formal_name }}’s roles">
        {% for role in roles %}
          <li class="relative m-0 flex flex-col items-center text-center">
            <span class="absolute -top-10 block h-10 w-[1.5px] bg-ink max-md:hidden" aria-hidden="true"></span>
            <span class="block size-10 {{ shapes[role.mission] }}" aria-hidden="true"></span>
            <p class="mt-4 mb-0 text-sm font-bold tracking-[0.08em] uppercase text-ink-soft">{{ role.label }}</p>
            <p class="mt-2 mb-0 text-lg leading-snug">
              {% if role.url %}<a href="{{ role.url }}">{{ role.text }}</a>{% else %}{{ role.text }}{% endif %}
            </p>
          </li>
        {% endfor %}
      </ol>
    </div>
  </div>
</section>
