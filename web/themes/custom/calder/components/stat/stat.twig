{% set rules = { care: 'border-care', learn: 'border-learn', discover: 'border-discover', neutral: 'border-current' } %}
<div class="flex flex-col gap-3 border-l-2 ps-5 {{ rules[mission|default('neutral')] }}">
  <p class="m-0 font-serif text-[3.5rem] leading-none" style="font-variation-settings: 'opsz' 60">{{ value }}</p>
  <p class="m-0 text-base opacity-85">{{ label }}</p>
</div>
