<a href="{{ url }}" class="group flex h-full flex-col gap-3 rounded-xl border border-line bg-paper p-4 text-ink no-underline transition-colors hover:border-ink">
  <span class="text-ink-soft group-hover:text-ink">{{ icon('phosphor', icon|default('arrow-right'), { size: 26 }) }}</span>
  <span class="text-base leading-tight font-bold">{{ label }}</span>
</a>
