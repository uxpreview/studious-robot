{#
/**
 * @file
 * Calder logo: the mobile mark plus wordmark.
 *
 * The mark is drawn on a 44x40 grid: a main arm with a red (care) petal on one
 * side and a smaller arm carrying blue (learn) and ochre (discover) on the
 * other. The heavier red side sits closer to the pivot, so it balances.
 */
#}
{% set tone = tone|default('dark') %}
{% set ink = tone == 'light' ? '#faf7f2' : '#16181d' %}
{% set tag = url ? 'a' : 'span' %}
<{{ tag }}{% if url %} href="{{ url }}" rel="home"{% endif %} class="group inline-flex items-center gap-3 no-underline {{ tone == 'light' ? 'text-paper' : 'text-ink' }}">
  <svg class="h-10 w-11 shrink-0 transition-transform duration-700 ease-[var(--ease-calder)] group-hover:rotate-[4deg]" style="transform-origin: 21px 1px" viewBox="0 0 44 40" aria-hidden="true" focusable="false">
    <g fill="none" stroke="{{ ink }}" stroke-width="1.9" stroke-linecap="round">
      <path d="M21 0.5V7.2"/>
      <path d="M8 13.2C11 6.4 31 6.4 34 11.6"/>
      <path d="M8 13.2V17.8"/>
      <path d="M34 11.6V15.2"/>
      <path d="M27.6 18.6C29.6 14.9 38 14.9 40.2 17.8"/>
      <path d="M27.6 18.6V22.8"/>
      <path d="M40.2 17.8V21.6"/>
    </g>
    <path fill="#c23a2b" d="M8.4 17.4C12.6 17.2 14.9 20.4 14.6 24.2C14.3 28 11.4 30.5 7.6 30.3C3.9 30.1 1.5 27.4 1.7 23.8C1.9 20.2 4.6 17.6 8.4 17.4Z"/>
    <circle fill="#2346b0" cx="27.6" cy="27" r="4.4"/>
    <circle fill="#ebaa2a" cx="40.2" cy="25.2" r="3.5"/>
  </svg>
  {% if not mark_only %}
    <span class="flex flex-col leading-none">
      <span class="font-serif text-[1.7rem] font-medium tracking-[-0.01em]" style="font-variation-settings: 'opsz' 36">Calder</span>
      <span class="mt-1 text-[0.6875rem] font-bold tracking-[0.16em] whitespace-nowrap uppercase {{ tone == 'light' ? 'text-paper/80' : 'text-ink-soft' }}">University Health</span>
    </span>
  {% else %}
    <span class="sr-only">Calder University Health</span>
  {% endif %}
</{{ tag }}>
